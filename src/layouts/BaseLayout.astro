---
/* Hallmark · genre: editorial · nav: N6 newspaper masthead · footer: Ft4 dense colophon
 * design-system: design.md · designed-as-app
 */
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { profile, plainText } from '../lib/profile';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = profile.description } = Astro.props;

const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

/* 마스트헤드 발행 라인은 실제 수치로 채웁니다 — 지어낸 지표를 쓰지 않습니다. */
const published = await getCollection('assets', ({ data }) => !data.draft);
const updated = published
  .map((e) => e.data.updated.getTime())
  .reduce((a, b) => Math.max(a, b), 0);
const mastLine = `자산 ${published.length}건 · 갱신 ${new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
}).format(new Date(updated))}`;

const nav = [
  { href: '/work', label: '작업' },
  { href: '/assets', label: '자산' },
  { href: '/about', label: '경험' },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${plainText(profile.headline)} ${profile.name} 포트폴리오`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site).href} />

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Pretendard dynamic-subset: 한글을 unicode-range 청크로 쪼개 실제 쓰인 음절만 받습니다. */}
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    {/* JetBrains Mono — 코드·식별자 전용. 400/500 두 웨이트만.
        디자인 시스템은 100~800 전 범위를 자체 호스팅하지만, 이 사이트가
        모노를 쓰는 자리는 세 곳(코드 배지·페이로드·콜로폰)뿐이라
        두 웨이트면 충분하고 그만큼 덜 받습니다. */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>

  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>

    <header class="topbar">
      <div class="page bar">
        <a class="wordmark" href="/">
          <span class="dot" aria-hidden="true"></span>
          <span class="wm-name">{profile.name}</span>
          <span class="wm-role">{profile.role}</span>
        </a>
        <nav class="topnav" aria-label="주요">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="colophon">
      <div class="page">
        <p>
          {profile.name} · {profile.role} ·
          <a href={`mailto:${profile.email}`}>{profile.email}</a> ·
          <a href={profile.github} rel="me">github.com/namtank96</a> · Pretendard 와 JetBrains Mono 로
          조판 · Astro 로 빌드 · 공개한 자산은 특정 조직·프로젝트와 무관하게 다시 쓴 일반 템플릿입니다 ·
          <span class="nums">{mastLine}</span> ·
          <span class="nums">2026</span>
        </p>
      </div>
    </footer>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
      }
      .skip:focus {
        left: var(--space-sm);
        top: var(--space-sm);
        z-index: 10;
        background: var(--color-paper);
        padding: var(--space-2xs) var(--space-sm);
        border: var(--rule-hair) solid var(--color-ink);
      }

      /* ── 상단바 — 좌측 워드마크 · 우측 내비 ────────── */
      .topbar {
        position: sticky;
        top: 0;
        z-index: 20;
        background: var(--color-paper);
        border-bottom: var(--rule-hair) solid var(--color-rule);
      }
      .bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-sm);
        min-height: var(--topbar-h);
      }

      .wordmark {
        display: flex;
        align-items: baseline;
        gap: var(--space-2xs);
        text-decoration: none;
        min-width: 0;
      }
      /* 그린 점 — 시스템의 상태 점 어휘. 로고를 쓰지 않는 자리의 표식입니다. */
      .dot {
        width: 7px;
        height: 7px;
        border-radius: var(--radius-pill);
        background: var(--color-accent-bright);
        flex: none;
        align-self: center;
      }
      .wm-name {
        font-weight: 700;
        font-size: var(--text-md);
        letter-spacing: 0;
        white-space: nowrap;
      }
      .wm-role {
        font-size: var(--text-xs);
        color: var(--color-ink-3);
        white-space: nowrap;
      }

      .topnav ul {
        display: flex;
        gap: var(--space-3xs);
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: var(--text-sm);
      }
      /* 44px 히트 타깃 — 복사 버튼과 같은 기준입니다. */
      .topnav a {
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
        padding-inline: var(--space-xs);
        border-radius: var(--radius-input);
        color: var(--color-ink-2);
        text-decoration: none;
        white-space: nowrap; /* 클릭 대상은 두 줄로 접히지 않습니다 */
      }
      .topnav a:hover {
        background: var(--color-paper-3);
        color: var(--color-ink);
      }
      /* 현재 위치는 색만으로 알리지 않습니다 — 면을 채워 형태로도 구분합니다. */
      .topnav a[aria-current='page'] {
        background: var(--color-paper-3);
        color: var(--color-ink);
        font-weight: 600;
      }

      @media (max-width: 30rem) {
        .wm-role {
          display: none;
        }
        .topnav a {
          padding-inline: var(--space-2xs);
        }
      }

      /* ── Ft4 dense colophon ──────────────────────── */
      .colophon {
        margin-top: var(--space-3xl);
        border-top: var(--rule-hair) solid var(--color-rule);
        background: var(--color-paper-2);
        padding-block: var(--space-md) var(--space-xl);
      }
      .colophon p {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        line-height: 1.85;
        color: var(--color-ink-2);
        max-width: 60ch;
      }
      .colophon a {
        color: inherit;
      }
      .colophon a:hover {
        color: var(--color-accent);
      }

      @media (max-width: 40rem) {
        .colophon p {
          font-size: 0.75rem;
        }
      }
    </style>
  </body>
</html>
