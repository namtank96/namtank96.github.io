---
/* Hallmark · genre: editorial · nav: N6 newspaper masthead · footer: Ft4 dense colophon
 * design-system: design.md · designed-as-app
 */
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { profile } from '../lib/profile';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = profile.description } = Astro.props;

const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

/* 마스트헤드 발행 라인은 실제 수치로 채웁니다 — 지어낸 지표를 쓰지 않습니다. */
const published = await getCollection('assets', ({ data }) => !data.draft);
const updated = published
  .map((e) => e.data.updated.getTime())
  .reduce((a, b) => Math.max(a, b), 0);
const mastLine = `자산 ${published.length}건 · 갱신 ${new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
}).format(new Date(updated))}`;

const nav = [
  { href: '/work', label: '작업' },
  { href: '/assets', label: '자산' },
  { href: '/about', label: '경험' },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${profile.headline} ${profile.name} 포트폴리오`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site).href} />

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Pretendard dynamic-subset: 한글을 unicode-range 청크로 쪼개 실제 쓰인 음절만 받습니다. */}
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    {/* Noto Serif KR — display 전용. 600/700 두 웨이트만. */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@600;700&display=swap"
    />
  </head>

  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>

    <header class="mast">
      <div class="page">
        <p class="mast-line nums">{mastLine}</p>
        <a class="mast-name" href="/">{profile.name}</a>
        <p class="mast-role">{profile.role}</p>
        <nav class="mast-nav" aria-label="주요">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
      <hr class="mast-rule" aria-hidden="true" />
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="colophon">
      <div class="page">
        <p>
          {profile.name} · {profile.role} ·
          <a href={`mailto:${profile.email}`}>{profile.email}</a> ·
          <a href={profile.github} rel="me">github.com/namtank96</a> · Noto Serif KR 과 Pretendard 로
          조판 · Astro 로 빌드 · 공개한 자산은 특정 조직·프로젝트와 무관하게 다시 쓴 일반 템플릿입니다 ·
          <span class="nums">2026</span>
        </p>
      </div>
    </footer>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
      }
      .skip:focus {
        left: var(--space-sm);
        top: var(--space-sm);
        z-index: 10;
        background: var(--color-paper);
        padding: var(--space-2xs) var(--space-sm);
        border: var(--rule-hair) solid var(--color-ink);
      }

      /* ── N6 신문 마스트헤드 ───────────────────────── */
      .mast {
        padding-top: var(--space-md);
      }
      .mast .page {
        display: grid;
        justify-items: center;
        gap: var(--space-3xs);
        text-align: center;
      }

      .mast-line {
        font-size: var(--text-xs);
        letter-spacing: 0.1em;
        color: var(--color-ink-2);
      }

      .mast-name {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(2rem, 6vw, 3.25rem);
        line-height: 1;
        letter-spacing: -0.03em;
        text-decoration: none;
      }

      .mast-role {
        font-size: var(--text-xs);
        color: var(--color-ink-2);
      }

      .mast-nav ul {
        display: flex;
        /* 링크 안쪽 여백이 8px 씩 늘었으므로 그만큼 줄여
         * 눈에 보이는 간격은 그대로 32px 을 유지합니다. */
        gap: var(--space-sm);
        list-style: none;
        padding: 0;
        margin-top: var(--space-3xs);
        font-size: var(--text-sm);
      }
      /* 44px 히트 타깃 — 복사 버튼과 같은 기준입니다.
       * 이전에는 34px 라 손가락 기준에 못 미쳤습니다. */
      .mast-nav a {
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
        padding-inline: var(--space-2xs);
        color: var(--color-ink-2);
        text-decoration: none;
        white-space: nowrap; /* 클릭 대상은 두 줄로 접히지 않습니다 */
      }
      .mast-nav a:hover,
      .mast-nav a[aria-current='page'] {
        color: var(--color-accent);
      }

      /* 이중 괘선 — 브로드시트 어휘 */
      .mast-rule {
        border: 0;
        border-top: var(--rule-hair) solid var(--color-ink);
        border-bottom: var(--rule-hair) solid var(--color-rule);
        height: 3px;
        margin-top: var(--space-md);
      }

      /* ── Ft4 dense colophon ──────────────────────── */
      .colophon {
        margin-top: var(--space-3xl);
        border-top: var(--rule-hair) solid var(--color-rule);
        padding-block: var(--space-md) var(--space-xl);
      }
      .colophon p {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        line-height: 1.85;
        color: var(--color-ink-2);
        max-width: 60ch;
      }
      .colophon a {
        color: inherit;
      }
      .colophon a:hover {
        color: var(--color-accent);
      }

      @media (max-width: 40rem) {
        .colophon p {
          font-size: 0.75rem;
        }
      }
    </style>
  </body>
</html>
