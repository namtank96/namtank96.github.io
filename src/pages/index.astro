---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AssetCard from '../components/AssetCard.astro';
import ArcDiagram from '../components/ArcDiagram.astro';
import { profile } from '../lib/profile';

const assets = (await getCollection('assets', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout>
  <section class="hero page">
    <p class="eyebrow">{profile.name} · {profile.role}</p>

    <h1>{profile.headline}</h1>

    <div class="intro prose">
      {profile.intro.map((line) => <p>{line}</p>)}
    </div>

    <div class="cta">
      <a class="btn btn-primary" href="/assets">자산 보기</a>
      <a class="btn" href="/about">경험 보기</a>
    </div>

    <ul class="proof">
      {profile.proof.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="page assets-section">
    <div class="section-head">
      <h2>업무 흐름과 자산</h2>
      <a href="/assets">전체 보기 →</a>
    </div>
    <ArcDiagram />

    <div class="grid">
      {assets.map((entry) => <AssetCard entry={entry} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-24) var(--space-16);
  }

  .eyebrow {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  h1 {
    font-size: var(--text-3xl);
    max-width: 20ch;
  }

  .intro {
    margin-top: var(--space-6);
    color: var(--color-text-muted);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .btn {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .btn-primary {
    background: var(--color-text);
    border-color: var(--color-text);
    color: var(--color-bg);
  }

  .proof {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-12);
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .proof li + li::before {
    content: '·';
    margin-right: var(--space-6);
  }

  .assets-section {
    padding-top: var(--space-8);
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-6);
  }
  .section-head h2 {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }
  .section-head a {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .section-head a:hover {
    color: var(--color-text);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  @media (max-width: 600px) {
    .hero {
      padding-block: var(--space-16) var(--space-12);
    }
    h1 {
      font-size: var(--text-2xl);
    }
  }
</style>
