---
/* Hallmark · genre: editorial · macrostructure: Index-First · theme: custom
 * design-system: design.md · designed-as-app · enrichment: none · nav: N6 · footer: Ft4
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AssetRow from '../components/AssetRow.astro';
import ArcDiagram from '../components/ArcDiagram.astro';
import { profile } from '../lib/profile';

const assets = (await getCollection('assets', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout>
  <section class="lede page">
    <h1>{profile.headline}</h1>
    <div class="intro prose">
      {profile.intro.map((line) => <p>{line}</p>)}
    </div>

    <p class="proof nums">{profile.proof.join(' · ')}</p>
  </section>

  <section class="index page">
    {/* 라벨과 제목을 같은 행에 두지 않습니다 — 수직 스택만. */}
    <div class="index-head">
      <h2>자산 {assets.length}건 · 업무 흐름 순</h2>
      <ArcDiagram />
    </div>

    <ol class="rows">
      {assets.map((entry) => <AssetRow entry={entry} />)}
    </ol>
  </section>

  <section class="tail page">
    <p class="prose">
      이 자산들은 취미가 아니라 <a href="/about">사업개발·사업관리 업무</a>에서 나왔습니다.
      어느 업무에서 무엇이 나왔는지도 적어 두었습니다.
    </p>
  </section>
</BaseLayout>

<style>
  /* 섹션마다 패딩을 달리 줍니다 — 균일한 패딩은 템플릿 신호입니다. */
  .lede {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  h1 {
    font-size: var(--text-display-s);
    max-width: 16ch;
  }

  .intro {
    margin-top: var(--space-md);
    color: var(--color-ink-2);
  }
  .intro p + p {
    margin-top: var(--space-2xs);
  }

  .index {
    padding-block: 0 var(--space-lg);
  }

  .proof {
    margin-top: var(--space-md);
    padding-top: var(--space-2xs);
    border-top: var(--rule-hair) solid var(--color-rule);
    max-width: var(--measure);
    font-size: var(--text-xs);
    color: var(--color-ink-2);
  }

  .index-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin-bottom: var(--space-sm);
  }
  .index-head h2 {
    font-size: var(--text-md);
    font-weight: 600;
    letter-spacing: 0;
  }

  .rows {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tail {
    padding-block: var(--space-xl) 0;
  }
  .tail p {
    color: var(--color-ink-2);
    font-size: var(--text-sm);
  }
  .tail a {
    color: var(--color-accent);
  }
</style>
