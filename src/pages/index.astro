---
/* Hallmark · genre: editorial · macrostructure: Index-First · theme: custom
 * design-system: design.md · designed-as-app · enrichment: none · nav: N6 · footer: Ft4
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AssetRow from '../components/AssetRow.astro';
import ArcDiagram from '../components/ArcDiagram.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, WEAPONS, headlineLines } from '../lib/profile';
import { GROUP_LABEL, GROUP_NOTE, GROUP_ORDER, type Group } from '../lib/labels';

const assets = (await getCollection('assets', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

/* 15행을 한 덩어리로 두면 스크롤이 단조로워집니다. 묶음으로 끊습니다. */
const grouped = GROUP_ORDER.map((g: Group) => ({
  key: g,
  label: GROUP_LABEL[g],
  note: GROUP_NOTE[g],
  items: assets.filter((a) => a.data.group === g),
})).filter((g) => g.items.length > 0);
const experience = (await getCollection('experience', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.order - a.data.order,
);
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.order - a.data.order,
);

const f = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}`;
const oldest = experience[experience.length - 1];
---

<BaseLayout>
  <section class="lede page">
    <h1>
      {
        headlineLines(profile.headline).map((segs) => (
          <span class="line">
            {segs.map((seg, i) => (
              <span class="seg">
                {i > 0 ? ' ' : ''}
                {seg}
              </span>
            ))}
          </span>
        ))
      }
    </h1>
    <div class="intro prose">
      {profile.intro.map((line) => <p>{line}</p>)}
    </div>
  </section>

  {/* 궤적 — 도메인이 끊기지 않았다는 것이 한눈에 보여야 합니다 */}
  <section class="track page">
    <h2>궤적</h2>
    <ol class="rail">
      {
        experience.map((e) => (
          <li>
            <span class="when nums">
              {f(e.data.start)} – {e.data.end ? f(e.data.end) : '현재'}
            </span>
            <span class="who">{e.data.company}</span>
            <span class="what">{e.data.role}</span>
          </li>
        ))
      }
    </ol>
    <p class="track-note">
      {oldest && `${oldest.data.start.getFullYear()}년 이후`} 회사와 역할은 바뀌었으나 도메인은
      유지됐습니다. <a href="/about">프로젝트 {projects.length}건으로 자세히 →</a>
    </p>
  </section>

  {/* 포트폴리오의 주인공은 작업입니다. 자산보다 위에 둡니다. */}
  <section class="work page">
    <div class="sec-head">
      <h2>프로젝트 {projects.length}건</h2>
      <p class="sec-note">건별로 문제 정의와 결정 사항을 기록했습니다.</p>
    </div>
    <div class="pgrid">
      {projects.map((p) => <ProjectCard entry={p} />)}
    </div>
  </section>

  <section class="weapons page">
    <h2>핵심 역량</h2>
    <ul>
      {
        WEAPONS.map((w) => (
          <li>
            <strong>{w.title}</strong>
            <span class="ev nums">{w.evidence}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="index page">
    <div class="index-head">
      <h2>공개한 자산 {assets.length}건</h2>
      <ArcDiagram />
    </div>

    {
      grouped.map((g) => (
        <div class="group">
          <p class="group-head">
            <span class="group-label">{g.label}</span>
            <span class="group-note">{g.note}</span>
            <span class="group-n nums">{g.items.length}</span>
          </p>
          <ol class="rows">
            {g.items.map((entry) => (
              <AssetRow entry={entry} />
            ))}
          </ol>
        </div>
      ))
    }
  </section>
</BaseLayout>

<style>
  .lede {
    padding-block: var(--space-2xl) var(--space-xl);
  }
  /* 홈 헤드라인만 display 를 씁니다. 다른 페이지는 display-s 라
   * 첫 화면이 확실히 한 단계 위에 있게 됩니다. */
  h1 {
    font-size: var(--text-display);
  }
  /* 손으로 끊은 표제 — 조각마다 한 줄입니다.
   * 좁은 화면에서 조각이 또 넘치면 그때만 자연 줄바꿈이 일어납니다. */
  h1 .line {
    display: block;
  }
  /* 조각은 기본이 인라인. 좁은 화면에서만 각자 줄을 차지합니다.
   * 안 그러면 375 에서 첫 줄이 다시 "확정된 게 / 없는" 으로 갈라집니다. */
  h1 .seg {
    display: inline;
  }
  @media (max-width: 40rem) {
    h1 .seg {
      display: block;
    }
  }
  .intro {
    margin-top: var(--space-md);
    color: var(--color-ink-2);
  }
  .intro p + p {
    margin-top: var(--space-2xs);
  }

  /* 섹션 제목이 그 안의 항목 제목보다 커야 위계가 읽힙니다.
   * 이전에는 섹션 17px / 자산 행 20px 이라 상하가 뒤집혀 있었습니다. */
  section > h2 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: 0;
    margin-bottom: var(--space-2xs);
  }
  section > h2::after {
    content: '';
    display: block;
    width: 1.75rem;
    height: 2px;
    margin-top: var(--space-2xs);
    background: var(--color-accent);
  }

  /* 궤적 */
  .track {
    padding-block: 0 var(--space-xl);
  }
  .rail {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .rail li {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-3xs) var(--space-sm);
    padding-block: var(--space-2xs);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  .when {
    font-size: var(--text-xs);
    color: var(--color-ink-2);
    white-space: nowrap;
  }
  .who {
    font-family: var(--font-display);
    font-weight: 500;
  }
  .what {
    grid-column: 2;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }
  .track-note {
    margin-top: var(--space-sm);
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }
  .track-note a {
    color: var(--color-accent);
    white-space: nowrap;
  }

  /* 프로젝트 */
  .work {
    padding-block: 0 var(--space-2xl);
  }
  .sec-head {
    margin-bottom: var(--space-lg);
  }
  .sec-note {
    margin-top: var(--space-2xs);
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }
  .pgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-md);
  }

  /* 무기 */
  .weapons {
    padding-block: 0 var(--space-xl);
  }
  .weapons ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-xs);
  }
  .weapons li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-sm);
  }
  .weapons strong {
    font-family: var(--font-display);
    font-weight: 500;
  }
  .ev {
    font-size: var(--text-xs);
    color: var(--color-ink-2);
  }

  .index {
    padding-block: 0 var(--space-lg);
  }
  .index-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-bottom: var(--space-lg);
  }

  /* 묶음 머리 — 라벨과 설명을 같은 줄에 두되 제목 위계는 주지 않습니다.
   * 섹션 제목(h2)과 경쟁하면 위계가 다시 흐려집니다. */
  .group + .group {
    margin-top: var(--space-xl);
  }
  .group-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-sm);
    padding-bottom: var(--space-2xs);
    border-bottom: 2px solid var(--color-ink);
  }
  .group-label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
  }
  .group-note {
    flex: 1;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }
  .group-n {
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  .rows {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (max-width: 40rem) {
    .rail li {
      grid-template-columns: minmax(0, 1fr);
    }
    .what {
      grid-column: 1;
    }
  }
</style>
