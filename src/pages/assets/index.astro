---
/* Hallmark · genre: editorial · macrostructure: Catalogue · theme: custom
 * design-system: design.md · designed-as-app · enrichment: none · nav: N6 · footer: Ft4
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AssetCard from '../../components/AssetCard.astro';
import ArcDiagram from '../../components/ArcDiagram.astro';
import { profile, headlineLines } from '../../lib/profile';
import { GROUP_LABEL, GROUP_NOTE, GROUP_ORDER, type Group } from '../../lib/labels';

const assets = (await getCollection('assets', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

/* 자산이 8건을 넘으면서 arc 하나로는 안 담깁니다. 세 묶음으로 나눕니다. */
const grouped = GROUP_ORDER.map((g: Group) => ({
  key: g,
  label: GROUP_LABEL[g],
  note: GROUP_NOTE[g],
  items: assets.filter((a) => a.data.group === g),
})).filter((g) => g.items.length > 0);
---

<BaseLayout
  title="자산"
  description="사업개발·사업관리 실무에서 사용하는 에이전트 운영 규칙과 업무 규격."
>
  <section class="head page">
    <h1>
      {
        headlineLines(profile.headlineAssets).map((segs) => (
          <span class="line">
            {segs.map((seg, i) => (
              <span class="seg">
                {i > 0 ? ' ' : ''}
                {seg}
              </span>
            ))}
          </span>
        ))
      }
    </h1>
    <p class="prose">
      제안·진단·검토에서 반복되는 판단을 규격으로 정리한 문서입니다. 실무에서 사용하던 파일에서
      회사·고객 정보만 제거해 공개합니다. 붙여넣으면 바로 동작합니다.
    </p>
    <p class="count nums">총 {assets.length}건 · 묶음 {grouped.length}개</p>
  </section>

  {
    grouped.map((g) => (
      <section class="group page">
        <div class="group-head">
          <h2>
            {g.label} <span class="n nums">{g.items.length}</span>
          </h2>
          <p class="note">{g.note}</p>
          {g.key === 'flow' && <ArcDiagram />}
        </div>

        <div class="grid">
          {g.items.map((entry) => (
            <AssetCard entry={entry} />
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  .head {
    padding-block: var(--space-2xl) var(--space-lg);
  }
  h1 {
    font-size: var(--text-display-s);
  }
  /* 손으로 끊은 표제 — 조각마다 한 줄. max-width 로 또 자르면
   * 손으로 정한 줄바꿈이 무너집니다. */
  h1 .line {
    display: block;
  }
  /* 조각은 기본이 인라인. 좁은 화면에서만 각자 줄을 차지합니다.
   * 안 그러면 375 에서 첫 줄이 다시 "확정된 게 / 없는" 으로 갈라집니다. */
  h1 .seg {
    display: inline;
  }
  @media (max-width: 40rem) {
    h1 .seg {
      display: block;
    }
  }
  .head p.prose {
    margin-top: var(--space-md);
    color: var(--color-ink-2);
  }
  .count {
    margin-top: var(--space-sm);
    font-size: var(--text-xs);
    color: var(--color-ink-2);
    letter-spacing: 0.04em;
  }

  .group {
    padding-block: 0 var(--space-xl);
  }
  /* 라벨과 제목을 같은 행에 두지 않습니다 — 수직 스택만. */
  .group-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding-bottom: var(--space-2xs);
    border-bottom: 2px solid var(--color-ink);
    margin-bottom: var(--space-md);
  }
  .group-head h2 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: 0;
  }
  .n {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-accent);
    vertical-align: super;
  }
  .note {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    max-width: var(--measure);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-md);
  }
</style>
