---
/* Hallmark · genre: editorial · macrostructure: Catalogue · theme: custom
 * design-system: design.md · designed-as-app · enrichment: none · nav: N6 · footer: Ft4
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AssetCard from '../../components/AssetCard.astro';
import { profile } from '../../lib/profile';
import { arcStep } from '../../lib/labels';

const assets = (await getCollection('assets', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

/* Catalogue 의 카테고리 라벨 밴드 — arc 단계별로 묶습니다. */
const groups = assets.map((entry) => ({ entry, step: arcStep(entry.data.code) ?? '기타' }));
---

<BaseLayout
  title="자산"
  description="사업개발·사업관리 실무에서 쓰는 에이전트 운영 규칙과 업무 규격. 읽고 그대로 복사해 가세요."
>
  <section class="head page">
    <h1>{profile.headlineAssets}</h1>
    <p class="prose">
      제안·진단·검토를 사람의 컨디션이 아니라 규격이 보증하게 만들려고 쓴 것들입니다.
      전부 실무에서 쓰다가 일반화했고, 붙여넣기만 하면 바로 돕니다.
    </p>
    <p class="count nums">전 {assets.length}건 · 업무 흐름 순</p>
  </section>

  <section class="grid-wrap page">
    <div class="grid">
      {
        groups.map(({ entry, step }) => (
          <div class="cell">
            <p class="band">{step}</p>
            <AssetCard entry={entry} />
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .head {
    padding-block: var(--space-2xl) var(--space-lg);
  }
  h1 {
    font-size: var(--text-display-s);
    max-width: 18ch;
  }
  .head p.prose {
    margin-top: var(--space-md);
    color: var(--color-ink-2);
  }
  .count {
    margin-top: var(--space-sm);
    font-size: var(--text-xs);
    color: var(--color-ink-2);
    font-variant: small-caps;
    letter-spacing: 0.08em;
  }

  .grid-wrap {
    padding-bottom: var(--space-lg);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-lg) var(--space-md);
  }

  .cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    min-width: 0;
  }
  .band {
    font-size: var(--text-xs);
    color: var(--color-ink-2);
    padding-bottom: var(--space-3xs);
    border-bottom: var(--rule-hair) solid var(--color-ink);
  }
  .cell > :global(.card) {
    flex: 1;
  }
</style>
