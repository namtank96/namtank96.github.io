---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AssetCard from '../../components/AssetCard.astro';
import ArcDiagram from '../../components/ArcDiagram.astro';
import { profile } from '../../lib/profile';

const assets = (await getCollection('assets', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="자산"
  description="사업개발·사업관리 실무에서 쓰는 에이전트 운영 규칙과 업무 규격. 읽고 그대로 복사해 가세요."
>
  <section class="intro page">
    <h1>{profile.headlineAssets}</h1>
    <p class="prose">
      제안·진단·검토를 사람의 컨디션이 아니라 규격이 보증하게 만들려고 쓴 것들입니다.
      전부 실무에서 쓰다가 일반화한 것이고, 붙여넣기만 하면 바로 돕니다.
    </p>

    <div class="arc-wrap">
      <p class="arc-label">업무 흐름</p>
      <ArcDiagram />
    </div>
  </section>

  <section class="page">
    <div class="grid">
      {assets.map((entry) => <AssetCard entry={entry} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-block: var(--space-16) var(--space-8);
  }
  h1 {
    font-size: var(--text-2xl);
  }
  .intro p {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
  }

  .arc-wrap {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  .arc-label {
    margin-bottom: var(--space-3) !important;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-4);
  }
</style>
