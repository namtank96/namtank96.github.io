---
/* Hallmark · genre: editorial · macrostructure: Long Document · theme: custom
 * design-system: design.md · designed-as-app · enrichment: none · nav: N6 · footer: Ft4
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CopyBlock from '../../components/CopyBlock.astro';
import { getPayload, payloadLineCount } from '../../lib/payloads';
import { KIND_LABEL, arcStep, formatDate } from '../../lib/labels';

export async function getStaticPaths() {
  const entries = await getCollection('assets', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'assets'>;
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const payload = getPayload(d.payload);

const all = (await getCollection('assets', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const related = d.related
  .map((code) => all.find((e) => e.data.code === code))
  .filter((e): e is CollectionEntry<'assets'> => Boolean(e));

const spec: [string, string][] = [
  ['형식', KIND_LABEL[d.kind]],
  ['붙이는 곳', d.install],
  ['분량', `${payloadLineCount(d.payload)}줄`],
  ['업무 단계', arcStep(d.code) ?? '—'],
  ['버전', `${d.version} · ${formatDate(d.updated)}`],
];
---

<BaseLayout title={d.title} description={d.summary}>
  <article class="doc page">
    <header>
      <p class="code nums">{d.code}</p>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>

      <dl class="spec nums">
        {
          spec.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    <section class="prose">
      <h2>언제 쓰나</h2>
      <ul>
        {d.whenToUse.map((w) => <li>{w}</li>)}
      </ul>

      <h2>안 쓰는 경우</h2>
      <p>{d.whenNotToUse}</p>

      <h2>입력</h2>
      <p>{d.input}</p>

      <h2>사용법</h2>
      <ol>
        {d.steps.map((s) => <li>{s}</li>)}
      </ol>
    </section>

    <section class="payload">
      <h2>본문</h2>
      <CopyBlock text={payload} />
    </section>

    {/* 출력 예시 + 이 규칙의 근거 — 본문 마크다운에서 옴 */}
    <section class="prose body">
      <Content />
    </section>

    {
      d.caveats.length > 0 && (
        <section class="prose">
          <h2>주의점·한계</h2>
          <ul>
            {d.caveats.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="prose">
      <h2>변경 이력</h2>
      <ul class="changelog nums">
        {
          d.changelog.map((c) => (
            <li>
              <code>{c.version}</code> · {formatDate(c.date)} · {c.note}
            </li>
          ))
        }
      </ul>
    </section>

    {
      related.length > 0 && (
        <nav class="related" aria-label="관련 자산">
          <h2>업무 흐름에서 앞뒤에 오는 것</h2>
          <ul>
            {related.map((r) => (
              <li>
                <a href={`/assets/${r.id}`}>
                  <span class="rcode nums">{r.data.code}</span>
                  <span>{r.data.title}</span>
                  <span class="rsum">{r.data.summary}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .doc {
    padding-block: var(--space-2xl) var(--space-lg);
  }

  header {
    padding-bottom: var(--space-lg);
    border-bottom: var(--rule-hair) solid var(--color-ink);
  }
  .code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
  }
  h1 {
    font-size: var(--text-2xl);
    margin-top: var(--space-3xs);
    max-width: 20ch;
  }
  .lede {
    margin-top: var(--space-xs);
    color: var(--color-ink-2);
    max-width: var(--measure);
  }

  /* 스펙 시트 — 배지 알약 대신 정렬된 표 */
  .spec {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: var(--space-sm) var(--space-md);
    margin: var(--space-lg) 0 0;
    font-size: var(--text-xs);
  }
  .spec dt {
    color: var(--color-ink-2);
    margin-bottom: var(--space-3xs);
  }
  .spec dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  /* Long Document — 섹션 제목이 본문 흐름에서 솟아오릅니다.
   * 소형 대문자 eyebrow 를 쓰지 않습니다. */
  section {
    margin-top: var(--space-xl);
  }
  section :global(h2) {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: 0;
    margin-top: var(--space-xl);
    margin-bottom: var(--space-xs);
  }
  section > :global(h2:first-child) {
    margin-top: 0;
  }
  section :global(h2::after) {
    content: '';
    display: block;
    width: 1.75rem;
    height: 2px;
    margin-top: var(--space-2xs);
    background: var(--color-accent);
  }

  section :global(p) {
    margin-top: var(--space-xs);
  }
  section :global(li + li) {
    margin-top: var(--space-2xs);
  }
  section :global(ul),
  section :global(ol) {
    margin-top: var(--space-xs);
  }

  .body :global(pre) {
    margin-top: var(--space-sm);
    padding: var(--space-sm);
    background: var(--color-paper-2);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-card);
    overflow-x: auto;
    font-size: var(--text-xs);
    line-height: 1.7;
  }
  .body :global(code) {
    font-size: 0.9em;
  }
  .body :global(strong) {
    font-weight: 700;
  }

  .payload {
    /* 이 섹션은 측정폭을 넘어섭니다 — 원문은 접히면 안 되므로 */
    max-width: none;
  }
  .payload h2 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }
  .payload h2::after {
    content: '';
    display: block;
    width: 1.75rem;
    height: 2px;
    margin-top: var(--space-2xs);
    background: var(--color-accent);
  }

  .changelog code {
    font-size: var(--text-xs);
  }

  .related {
    margin-top: var(--space-2xl);
    padding-top: var(--space-md);
    border-top: var(--rule-hair) solid var(--color-ink);
  }
  .related h2 {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }
  .related ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .related li {
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  .related a {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    gap: var(--space-3xs) var(--space-sm);
    padding-block: var(--space-xs);
    text-decoration: none;
  }
  .related a:hover {
    color: var(--color-accent);
  }
  .rcode {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
  }
  .rsum {
    grid-column: 2;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }
</style>
