---
/* Hallmark · genre: editorial · macrostructure: Long Document · theme: custom
 * design-system: design.md · designed-as-app · enrichment: none · nav: N6 · footer: Ft4
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, headlineLines, METHOD, WEAPONS } from '../lib/profile';

const experience = (await getCollection('experience', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.order - a.data.order,
);
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.order - a.data.order,
);

const assets = await getCollection('assets', ({ data }) => !data.draft);
const assetByCode = new Map(assets.map((e) => [e.data.code, e]));

function assetLink(code: string) {
  const e = assetByCode.get(code);
  return e ? { href: `/assets/${e.id}`, label: e.data.title } : null;
}

const period = (start: Date, end?: Date) => {
  const f = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}`;
  return `${f(start)} – ${end ? f(end) : '현재'}`;
};

/** 회사별로 프로젝트를 묶습니다 — "어디서 무슨 일을 했는가"가 이 구조에서 읽힙니다. */
const byCompany = experience.map((e) => ({
  exp: e,
  projects: projects.filter((p) => p.data.at === e.id),
}));

const certs = ['SQLD', 'MS Azure Fundamentals', 'MS Azure AI Fundamentals'];
const skills = [...new Set(experience.flatMap((e) => e.data.skills))];

const first = experience[experience.length - 1];
const span = first ? `${first.data.start.getFullYear()}년부터` : '';
---

<BaseLayout
  title="경험"
  description="AI·Data 분야에서 서비스 기획부터 AX 사업개발까지. 소속별 담당 업무와 주요 판단 기록."
>
  <article class="doc page">
    <header>
      <h1>
      {
        headlineLines(profile.headlineAbout).map((segs) => (
          <span class="line">
            {segs.map((seg, i) => (
              <span class="seg">
                {i > 0 ? ' ' : ''}
                {seg}
              </span>
            ))}
          </span>
        ))
      }
    </h1>
      <p class="lede">{profile.intro[0]}</p>
      <p class="lede">{profile.intro[1]}</p>
    </header>

    <section class="weapons-section">
      <h2>핵심 역량</h2>
      <p class="sec-lede">다섯 가지를 정리했습니다. 각 항목에 확인 가능한 근거를 기재했습니다.</p>
      <ol class="weapons">
        {
          WEAPONS.map((w) => (
            <li>
              <h3>{w.title}</h3>
              <p>{w.body}</p>
              <p class="evidence nums">{w.evidence}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="career-section">
      <h2>경력 사항</h2>
      <p class="sec-lede">{span} 세 개 조직. 담당 업무는 콘텐츠 기획에서 사업개발로 이동했습니다.</p>

      {
        byCompany.map(({ exp, projects: ps }) => (
          <div class="company">
            <div class="company-head">
              <h3>{exp.data.company}</h3>
              <p class="muted nums">
                {exp.data.role} · {period(exp.data.start, exp.data.end)}
              </p>
            </div>
            <p class="company-summary">{exp.data.summary}</p>

            {/* 상세는 케이스 스터디 페이지가 담당합니다. 여기는 목록만 —
                같은 내용을 두 곳에 두면 한쪽이 반드시 낡습니다. */}
            {ps.length > 0 && (
              <ul class="plist">
                {ps.map((p) => (
                  <li>
                    <a href={`/work/${p.id}`}>
                      <span class="pt">{p.data.title}</span>
                      <span class="pm nums">
                        {p.data.role}
                        {p.data.judgment.length > 0 && ` · 판단 ${p.data.judgment.length}건`}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </section>

    <section class="method-section">
      <h2>일하는 방식</h2>
      <ol class="method">
        {
          METHOD.map((m) => {
            const link = assetLink(m.asset);
            return (
              <li>
                <h3>{m.title}</h3>
                <p>{m.body}</p>
                {link && <a class="method-asset" href={link.href}>{link.label}</a>}
              </li>
            );
          })
        }
      </ol>
    </section>

    <section class="skills-section">
      <h2>역량 · 자격</h2>
      <p class="tagline">{skills.join(' · ')}</p>
      <p class="tagline muted nums">{certs.join(' · ')}</p>
    </section>

    <section class="prose">
      <h2>연락</h2>
      <p><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
    </section>
  </article>
</BaseLayout>

<style>
  .doc {
    padding-block: var(--space-2xl) var(--space-lg);
  }

  header {
    padding-bottom: var(--space-lg);
    border-bottom: var(--rule-hair) solid var(--color-ink);
  }
  h1 {
    font-size: var(--text-display-s);
  }
  /* 손으로 끊은 표제 — 조각마다 한 줄. max-width 로 또 자르면
   * 손으로 정한 줄바꿈이 무너집니다. */
  h1 .line {
    display: block;
  }
  /* 조각은 기본이 인라인. 좁은 화면에서만 각자 줄을 차지합니다.
   * 안 그러면 375 에서 첫 줄이 다시 "확정된 게 / 없는" 으로 갈라집니다. */
  h1 .seg {
    display: inline;
  }
  @media (max-width: 40rem) {
    h1 .seg {
      display: block;
    }
  }
  .lede {
    margin-top: var(--space-md);
    max-width: var(--measure);
    color: var(--color-ink-2);
  }

  section {
    margin-top: var(--space-2xl);
  }
  section > :global(h2) {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: 0;
    margin-bottom: var(--space-2xs);
  }
  section > :global(h2::after) {
    content: '';
    display: block;
    width: 1.75rem;
    height: 2px;
    margin-top: var(--space-2xs);
    background: var(--color-accent);
  }
  .sec-lede {
    margin-bottom: var(--space-lg);
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }

  /* 무기 */
  .weapons {
    list-style: none;
    padding: 0;
    counter-reset: w;
    display: grid;
    gap: var(--space-lg);
  }
  .weapons li {
    counter-increment: w;
    max-width: var(--measure);
    padding-left: var(--space-xl);
    position: relative;
  }
  .weapons li::before {
    content: counter(w);
    position: absolute;
    left: 0;
    top: 0.1em;
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
  }
  .weapons h3 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 500;
  }
  .weapons p {
    margin-top: var(--space-2xs);
    color: var(--color-ink-2);
  }
  .evidence {
    font-size: var(--text-xs) !important;
    padding-top: var(--space-2xs);
    border-top: var(--rule-hair) solid var(--color-rule);
    max-width: max-content;
  }

  /* 회사 + 프로젝트 */
  .company + .company {
    margin-top: var(--space-2xl);
  }
  .company-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-sm);
    padding-bottom: var(--space-2xs);
    border-bottom: 2px solid var(--color-ink);
  }
  .company-head h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
  }
  .muted {
    color: var(--color-ink-2);
    font-size: var(--text-sm);
  }
  .company-summary {
    margin-top: var(--space-sm);
    max-width: var(--measure);
    color: var(--color-ink-2);
  }
  .plist {
    list-style: none;
    padding: 0;
    margin-top: var(--space-md);
  }
  .plist li {
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  .plist li:first-child {
    border-top: var(--rule-hair) solid var(--color-rule);
  }
  .plist a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-sm);
    padding-block: var(--space-2xs);
    text-decoration: none;
  }
  .plist a:hover .pt {
    color: var(--color-accent);
    text-decoration: underline;
  }
  .pt {
    font-family: var(--font-display);
    font-weight: 500;
  }
  .pm {
    font-size: var(--text-xs);
    color: var(--color-ink-2);
  }

  /* 일하는 방식 */
  .method {
    list-style: none;
    padding: 0;
    counter-reset: m;
    display: grid;
    gap: var(--space-lg);
  }
  .method li {
    counter-increment: m;
    max-width: var(--measure);
    padding-left: var(--space-xl);
    position: relative;
  }
  .method li::before {
    content: counter(m);
    position: absolute;
    left: 0;
    top: 0.15em;
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
  }
  .method h3 {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 500;
  }
  .method p {
    margin-top: var(--space-3xs);
    color: var(--color-ink-2);
  }
  .method-asset {
    display: inline-block;
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  .tagline {
    max-width: 70ch;
    font-size: var(--text-sm);
    line-height: 1.9;
  }
  .tagline + .tagline {
    margin-top: var(--space-2xs);
  }

  section.prose :global(p) {
    margin-top: var(--space-xs);
  }

  @media (max-width: 40rem) {
    .weapons li,
    .method li {
      padding-left: var(--space-lg);
    }
  }
</style>
