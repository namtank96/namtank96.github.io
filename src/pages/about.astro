---
/* Hallmark · genre: editorial · macrostructure: Long Document · theme: custom
 * design-system: design.md · designed-as-app · enrichment: none · nav: N6 · footer: Ft4
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, METHOD, WORKS } from '../lib/profile';

const experience = (await getCollection('experience', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.order - a.data.order,
);

const assets = await getCollection('assets', ({ data }) => !data.draft);
const assetByCode = new Map(assets.map((e) => [e.data.code, e]));

function assetLink(code: string) {
  const entry = assetByCode.get(code);
  return entry ? { href: `/assets/${entry.id}`, label: entry.data.title } : null;
}

const period = (start: Date, end?: Date) => {
  const f = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}`;
  return `${f(start)} – ${end ? f(end) : '현재'}`;
};

const [current, ...past] = experience;
const certs = ['SQLD', 'MS Azure Fundamentals', 'MS Azure AI Fundamentals'];
const skills = [...new Set(experience.flatMap((e) => e.data.skills))];
---

<BaseLayout
  title="경험"
  description="AX 사업개발·사업관리. 제안·진단·검토를 사람이 아니라 규격이 보증하게 만듭니다."
>
  <article class="doc page">
    <header>
      <h1>{profile.headlineAbout}</h1>
      <p class="lede">
        제안·진단·검토를 사람의 컨디션이 아니라 규격이 보증하게 만듭니다.
        그 규격을 <a href="/assets">자산</a>으로 공개해 두었습니다.
      </p>
    </header>

    {
      current && (
        <section class="prose">
          <h2>지금 하는 일</h2>
          <p class="role nums">
            <strong>{current.data.company}</strong>
            <span class="muted">
              {current.data.team} · {period(current.data.start, current.data.end)}
            </span>
          </p>
          <p>{current.data.summary}</p>
          <ul>
            {current.data.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>

          {current.data.assetRefs.length > 0 && (
            <p class="from-here">
              이 업무에서 나온 자산 —{' '}
              {current.data.assetRefs.map((code, i) => {
                const link = assetLink(code);
                return (
                  <>
                    {i > 0 && ', '}
                    {link ? <a href={link.href}>{link.label}</a> : <span class="muted">{code}</span>}
                  </>
                );
              })}
            </p>
          )}
        </section>
      )
    }

    <section class="method-section">
      <h2>작업 방식</h2>
      <ol class="method">
        {
          METHOD.map((m) => {
            const link = assetLink(m.asset);
            return (
              <li>
                <h3>{m.title}</h3>
                <p>{m.body}</p>
                {link && <a class="method-asset" href={link.href}>{link.label}</a>}
              </li>
            );
          })
        }
      </ol>
    </section>

    <section class="works-section">
      <h2>만든 것</h2>
      <div class="works">
        {
          WORKS.map((w) => (
            <article class="work">
              <h3>{w.title}</h3>
              <dl>
                <dt>문제</dt>
                <dd>{w.problem}</dd>
                <dt>만든 것</dt>
                <dd>{w.built}</dd>
                <dt>규율</dt>
                <dd>{w.discipline}</dd>
                <dt>결과</dt>
                <dd>{w.result}</dd>
              </dl>
            </article>
          ))
        }
      </div>
    </section>

    <section class="prose">
      <h2>이전 경력</h2>
      {
        past.map((e) => (
          <div class="past">
            <p class="role nums">
              <strong>{e.data.company}</strong>
              <span class="muted">
                {e.data.role} · {period(e.data.start, e.data.end)}
              </span>
            </p>
            <ul>
              {e.data.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section class="skills-section">
      <h2>도구 · 역량</h2>
      <p class="tagline">{skills.join(' · ')}</p>
      <p class="tagline muted nums">{certs.join(' · ')}</p>
    </section>

    <section class="prose">
      <h2>연락</h2>
      <p><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
    </section>
  </article>
</BaseLayout>

<style>
  .doc {
    padding-block: var(--space-2xl) var(--space-lg);
  }

  header {
    padding-bottom: var(--space-lg);
    border-bottom: var(--rule-hair) solid var(--color-ink);
  }
  h1 {
    font-size: var(--text-display-s);
    max-width: 16ch;
  }
  .lede {
    margin-top: var(--space-md);
    max-width: var(--measure);
    color: var(--color-ink-2);
  }
  .lede a {
    color: var(--color-accent);
  }

  section {
    margin-top: var(--space-xl);
  }
  section > :global(h2) {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-xs);
  }
  section > :global(h2::after) {
    content: '';
    display: block;
    width: 1.75rem;
    height: 2px;
    margin-top: var(--space-2xs);
    background: var(--color-accent);
  }

  section :global(p) {
    margin-top: var(--space-xs);
  }
  section :global(ul) {
    margin-top: var(--space-xs);
  }
  section :global(li + li) {
    margin-top: var(--space-2xs);
  }

  .role {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-xs);
  }
  .role strong {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .muted {
    color: var(--color-ink-2);
    font-size: var(--text-sm);
  }

  .from-here {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }
  .from-here a {
    color: var(--color-accent);
  }

  /* 작업 방식 — 이 페이지의 심장. 다른 섹션보다 넓게 씁니다. */
  .method-section {
    margin-top: var(--space-2xl);
  }
  .method {
    list-style: none;
    padding: 0;
    counter-reset: m;
    display: grid;
    gap: var(--space-lg);
  }
  .method li {
    counter-increment: m;
    max-width: var(--measure);
    padding-left: var(--space-xl);
    position: relative;
  }
  .method li::before {
    content: counter(m);
    position: absolute;
    left: 0;
    top: 0.15em;
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
  }
  .method h3 {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 700;
  }
  .method p {
    margin-top: var(--space-3xs);
    color: var(--color-ink-2);
  }
  .method-asset {
    display: inline-block;
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  .works {
    display: grid;
    gap: var(--space-lg);
  }
  .work {
    max-width: var(--measure);
    padding-top: var(--space-xs);
    border-top: var(--rule-hair) solid var(--color-rule);
  }
  .work h3 {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 700;
    margin-bottom: var(--space-2xs);
  }
  .work dl {
    display: grid;
    grid-template-columns: 4.25rem minmax(0, 1fr);
    gap: var(--space-3xs) var(--space-sm);
    margin: 0;
    font-size: var(--text-sm);
  }
  .work dt {
    color: var(--color-ink-2);
    font-size: var(--text-xs);
    padding-top: 0.25em;
  }
  .work dd {
    margin: 0;
  }

  .past + .past {
    margin-top: var(--space-lg);
  }

  .tagline {
    max-width: 70ch;
    font-size: var(--text-sm);
    line-height: 1.9;
  }

  @media (max-width: 40rem) {
    .work dl {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .work dt {
      margin-top: var(--space-2xs);
    }
    .method li {
      padding-left: var(--space-lg);
    }
  }
</style>
