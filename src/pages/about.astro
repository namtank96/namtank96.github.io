---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, METHOD, WORKS } from '../lib/profile';

const experience = (await getCollection('experience', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.order - a.data.order,
);

const assets = await getCollection('assets', ({ data }) => !data.draft);
const assetByCode = new Map(assets.map((e) => [e.data.code, e]));

/** 자산 code → 링크. 아직 공개 안 된 자산은 링크 없이 코드만 남깁니다. */
function assetLink(code: string) {
  const entry = assetByCode.get(code);
  return entry ? { href: `/assets/${entry.id}`, label: entry.data.title } : null;
}

const period = (start: Date, end?: Date) => {
  const f = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}`;
  return `${f(start)} – ${end ? f(end) : '현재'}`;
};

const [current, ...past] = experience;

const certs = ['SQLD', 'MS Azure Fundamentals', 'MS Azure AI Fundamentals'];
---

<BaseLayout
  title="경험"
  description="AX 사업개발·사업관리. 제안·진단·검토를 사람이 아니라 규격이 보증하게 만듭니다."
>
  <article class="page about">
    <header>
      <h1>{profile.headlineAbout}</h1>
      <p class="lede">
        {profile.role} · {current && period(current.data.start, current.data.end)}
      </p>
      <p class="prose">
        제안·진단·검토를 사람의 컨디션이 아니라 규격이 보증하게 만듭니다.
        그 규격을 <a href="/assets">자산</a>으로 공개해 두었습니다.
      </p>
    </header>

    {
      current && (
        <section class="block">
          <h2>지금 하는 일</h2>
          <div class="role-head">
            <strong>{current.data.company}</strong>
            <span class="muted">
              {current.data.team} · {period(current.data.start, current.data.end)}
            </span>
          </div>
          <p class="prose summary">{current.data.summary}</p>

          <ul class="prose highlights">
            {current.data.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>

          {current.data.assetRefs.length > 0 && (
            <p class="from-here">
              이 업무에서 나온 자산 —{' '}
              {current.data.assetRefs.map((code, i) => {
                const link = assetLink(code);
                return (
                  <>
                    {i > 0 && ', '}
                    {link ? <a href={link.href}>{link.label}</a> : <span class="muted">{code}</span>}
                  </>
                );
              })}
            </p>
          )}
        </section>
      )
    }

    <section class="block">
      <h2>작업 방식</h2>
      <ol class="method">
        {
          METHOD.map((m) => {
            const link = assetLink(m.asset);
            return (
              <li>
                <h3>{m.title}</h3>
                <p>{m.body}</p>
                {link && (
                  <a class="method-asset" href={link.href}>
                    {link.label} →
                  </a>
                )}
              </li>
            );
          })
        }
      </ol>
    </section>

    <section class="block">
      <h2>만든 것</h2>
      <div class="works">
        {
          WORKS.map((w) => (
            <div class="work">
              <h3>{w.title}</h3>
              <dl>
                <dt>문제</dt>
                <dd>{w.problem}</dd>
                <dt>만든 것</dt>
                <dd>{w.built}</dd>
                <dt>규율</dt>
                <dd>{w.discipline}</dd>
                <dt>결과</dt>
                <dd>{w.result}</dd>
              </dl>
            </div>
          ))
        }
      </div>
    </section>

    <section class="block">
      <h2>이전 경력</h2>
      <ul class="past">
        {
          past.map((e) => (
            <li>
              <div class="role-head">
                <strong>{e.data.company}</strong>
                <span class="muted">
                  {e.data.role} · {period(e.data.start, e.data.end)}
                </span>
              </div>
              <ul class="prose highlights">
                {e.data.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block">
      <h2>도구 · 역량</h2>
      <div class="tags">
        {
          [...new Set(experience.flatMap((e) => e.data.skills))].map((s) => (
            <span class="tag">{s}</span>
          ))
        }
      </div>
      <div class="tags certs">
        {certs.map((c) => <span class="tag">{c}</span>)}
      </div>
    </section>

    <section class="block">
      <h2>연락</h2>
      <p><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
    </section>
  </article>
</BaseLayout>

<style>
  .about {
    padding-block: var(--space-16) var(--space-8);
  }

  header h1 {
    font-size: var(--text-2xl);
  }
  .lede {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  header p.prose {
    margin-top: var(--space-4);
  }

  .block {
    margin-top: var(--space-16);
  }
  .block > h2 {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-6);
  }

  .role-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
  }
  .role-head strong {
    font-size: var(--text-lg);
  }
  .muted {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .summary {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }
  .highlights {
    margin-top: var(--space-4);
  }
  .highlights li + li {
    margin-top: var(--space-2);
  }

  .from-here {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .method {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-8);
    counter-reset: m;
  }
  .method li {
    counter-increment: m;
    max-width: var(--measure);
  }
  .method h3 {
    font-size: var(--text-base);
  }
  .method h3::before {
    content: counter(m) '. ';
    color: var(--color-accent);
    font-family: var(--font-mono);
  }
  .method p {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }
  .method-asset {
    display: inline-block;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }

  .works {
    display: grid;
    gap: var(--space-8);
  }
  .work {
    max-width: var(--measure);
  }
  .work h3 {
    font-size: var(--text-base);
    margin-bottom: var(--space-3);
  }
  .work dl {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    font-size: var(--text-sm);
  }
  .work dt {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    padding-top: 0.2em;
  }
  .work dd {
    margin: 0;
  }

  .past {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-8);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .certs {
    margin-top: var(--space-3);
  }
  .tag {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0 var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (max-width: 560px) {
    .work dl {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .work dt {
      margin-top: var(--space-3);
    }
  }
</style>
