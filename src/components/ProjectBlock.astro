---
/* 프로젝트 한 건. 상황 → 한 일 → 판단 → 결과.
 * 판단이 비어 있으면 그 절을 렌더하지 않습니다 — 지어내지 않기로 했으므로. */
import type { CollectionEntry } from 'astro:content';
import { INDUSTRY_LABEL } from '../lib/labels';

interface Props {
  entry: CollectionEntry<'projects'>;
  assetLink: (code: string) => { href: string; label: string } | null;
}

const { entry, assetLink } = Astro.props;
const p = entry.data;

const f = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}`;
const period = `${f(p.start)} – ${p.end ? f(p.end) : '현재'}`;
const meta = [INDUSTRY_LABEL[p.industry], p.role, period, p.scale].filter(Boolean);
const links = p.assetRefs.map(assetLink).filter(Boolean) as { href: string; label: string }[];
---

<article class="project">
  <h3>{p.title}</h3>
  <p class="meta nums">{meta.join(' · ')}</p>

  <p class="situation">{p.situation}</p>

  <div class="part">
    <h4>한 일</h4>
    <ul>
      {p.did.map((d) => <li>{d}</li>)}
    </ul>
  </div>

  {
    p.judgment.length > 0 && (
      <div class="part judgment">
        <h4>내린 판단</h4>
        <dl>
          {p.judgment.map((j) => (
            <>
              <dt>{j.call}</dt>
              <dd>{j.why}</dd>
            </>
          ))}
        </dl>
      </div>
    )
  }

  {
    p.result && (
      <div class="part">
        <h4>결과</h4>
        <p>{p.result}</p>
      </div>
    )
  }

  {
    links.length > 0 && (
      <p class="from">
        여기서 나온 자산 —{' '}
        {links.map((l, i) => (
          <>
            {i > 0 && ', '}
            <a href={l.href}>{l.label}</a>
          </>
        ))}
      </p>
    )
  }
</article>

<style>
  .project {
    padding-top: var(--space-md);
    border-top: var(--rule-hair) solid var(--color-rule);
    max-width: var(--measure);
  }

  h3 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .meta {
    margin-top: var(--space-3xs);
    font-size: var(--text-xs);
    color: var(--color-ink-2);
  }

  .situation {
    margin-top: var(--space-sm);
    color: var(--color-ink-2);
  }

  .part {
    margin-top: var(--space-md);
  }
  .part h4 {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink-2);
    margin-bottom: var(--space-2xs);
  }
  .part ul {
    margin: 0;
    font-size: var(--text-sm);
  }
  .part li + li {
    margin-top: var(--space-3xs);
  }
  .part > p {
    font-size: var(--text-sm);
  }

  /* 판단 — 이 블록이 프로젝트의 핵심이라 액센트를 답니다 */
  .judgment dl {
    margin: 0;
    display: grid;
    gap: var(--space-sm);
  }
  .judgment dt {
    font-weight: 600;
    padding-left: var(--space-sm);
    border-left: 2px solid var(--color-accent);
  }
  .judgment dd {
    margin: var(--space-3xs) 0 0;
    padding-left: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }

  .from {
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }
  .from a {
    color: var(--color-accent);
  }
</style>
