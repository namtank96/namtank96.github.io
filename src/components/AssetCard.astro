---
/* Catalogue 의 스펙 카드. 아이콘 없음, 색 스트라이프 없음, "자세히 보기 →" 없음 —
 * 카드 전체가 링크입니다. 헤어라인 하나로만 담습니다. */
import type { CollectionEntry } from 'astro:content';
import { KIND_LABEL } from '../lib/labels';
import { payloadLineCount } from '../lib/payloads';

interface Props {
  entry: CollectionEntry<'assets'>;
}

const { entry } = Astro.props;
const { code, title, summary, kind, install } = entry.data;
const lines = payloadLineCount(entry.data.payload);
---

<a class="card" href={`/assets/${entry.id}`}>
  <span class="code nums">{code}</span>
  <h3>{title}</h3>
  <p class="summary">{summary}</p>

  <dl class="spec nums">
    <dt>형식</dt>
    <dd>{KIND_LABEL[kind]}</dd>
    <dt>붙이는 곳</dt>
    <dd>{install}</dd>
    <dt>분량</dt>
    <dd>{lines}줄</dd>
  </dl>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-md);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-card);
    background: var(--color-paper);
    text-decoration: none;
    transition:
      border-color var(--dur-short) var(--ease-out),
      background-color var(--dur-short) var(--ease-out);
  }
  /* hover 신호는 하나만 — 테두리. 색·이동·그림자를 겹쳐 주지 않습니다. */
  .card:hover {
    border-color: var(--color-rule-2);
    background: var(--color-paper-2);
  }

  .code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
  }

  /* 제목에 상시 밑줄을 답니다 — 터치 기기에는 hover 가 없습니다. */
  h3 {
    font-size: var(--text-md);
    font-weight: 700;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--color-ink-3);
    text-decoration-thickness: from-font;
    text-underline-offset: 0.22em;
  }
  .card:active {
    scale: 0.99;
  }
  .card:hover h3 {
    text-decoration-color: var(--color-accent);
    color: var(--color-accent);
  }

  .summary {
    color: var(--color-ink-2);
    font-size: var(--text-sm);
    flex: 1;
    text-wrap: pretty;
  }

  .spec {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--space-3xs) var(--space-2xs);
    margin: var(--space-2xs) 0 0;
    padding-top: var(--space-2xs);
    border-top: var(--rule-hair) solid var(--color-rule);
    font-size: var(--text-xs);
  }
  .spec dt {
    color: var(--color-ink-2);
  }
  .spec dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
</style>
