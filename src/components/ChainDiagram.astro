---
/**
 * 3단 사슬 도식 — 손으로 그린 인라인 SVG.
 * 외부 라이브러리 0, 토큰만 소비합니다. (A13 규칙 그대로)
 *
 * 사내 화면을 올릴 수 없으니 방법론의 구조를 그립니다.
 * 고객 정보가 하나도 안 들어가면서 "볼 것"이 생깁니다.
 */
interface Props {
  steps: [string, string, string];
  backLabel?: string;
  caption?: string;
}
const { steps, backLabel = '추적성', caption } = Astro.props;
---

<figure class="chain">
  <svg viewBox="0 0 720 170" role="img" aria-label={`${steps.join(' → ')} 3단 사슬. ${backLabel}은 역방향으로 검증됩니다.`}>
    {
      steps.map((s, i) => {
        const x = 8 + i * 244;
        return (
          <g>
            <rect x={x} y={30} width={204} height={62} rx="2" class="box" />
            <text x={x + 102} y={67} class="lbl">{s}</text>
            {i < 2 && (
              <g class="arrow">
                <line x1={x + 210} y1={61} x2={x + 236} y2={61} />
                <polygon points={`${x + 242},61 ${x + 232},56 ${x + 232},66`} />
              </g>
            )}
          </g>
        );
      })
    }
    {/* 역방향 추적성 */}
    <g class="back">
      <path d="M 620 100 L 620 130 L 110 130 L 110 100" fill="none" />
      <polygon points="110,94 105,104 115,104" />
      <rect x="318" y="118" width="94" height="24" rx="2" class="backbg" />
      <text x="365" y="134" class="backlbl">{backLabel}</text>
    </g>
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .chain {
    margin: 0;
  }
  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .box {
    fill: var(--color-paper-2);
    stroke: var(--color-ink);
    stroke-width: 1;
  }
  .lbl {
    fill: var(--color-ink);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    text-anchor: middle;
  }
  .arrow line {
    stroke: var(--color-ink);
    stroke-width: 1.5;
  }
  .arrow polygon {
    fill: var(--color-ink);
  }
  .back path {
    stroke: var(--color-accent);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
  }
  .back polygon {
    fill: var(--color-accent);
  }
  .backbg {
    fill: var(--color-paper);
  }
  .backlbl {
    fill: var(--color-accent);
    font-size: 13px;
    text-anchor: middle;
    font-variant-numeric: tabular-nums;
  }
  figcaption {
    margin-top: var(--space-2xs);
    font-size: var(--text-xs);
    color: var(--color-ink-2);
  }
</style>
