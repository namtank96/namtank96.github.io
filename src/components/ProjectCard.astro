---
import type { CollectionEntry } from 'astro:content';
import { INDUSTRY_LABEL } from '../lib/labels';

interface Props {
  entry: CollectionEntry<'projects'>;
}
const { entry } = Astro.props;
const d = entry.data;
const f = (x: Date) => `${x.getFullYear()}.${String(x.getMonth() + 1).padStart(2, '0')}`;
const first = (s: string) => (s.split(/(?<=\.)\s/)[0] ?? s).trim();
---

<a class="pcard" href={`/work/${entry.id}`}>
  <p class="tags nums">{INDUSTRY_LABEL[d.industry]} · {f(d.start)} – {d.end ? f(d.end) : '현재'}</p>
  <h3>{d.title}</h3>
  <p class="prob">{first(d.situation)}</p>
  <p class="foot nums">
    {d.role}{d.judgment.length > 0 && <span class="sep"> · 판단 {d.judgment.length}건</span>}
  </p>
</a>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-md);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-card);
    background: var(--color-paper);
    text-decoration: none;
    transition: border-color var(--dur-short) var(--ease-out);
  }
  .pcard:hover {
    border-color: var(--color-ink);
  }
  .tags {
    font-size: var(--text-xs);
    color: var(--color-ink-2);
  }
  h3 {
    font-size: var(--text-lg);
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .prob {
    flex: 1;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    line-height: 1.6;
  }
  .foot {
    margin-top: var(--space-2xs);
    padding-top: var(--space-2xs);
    border-top: var(--rule-hair) solid var(--color-rule);
    font-size: var(--text-xs);
    color: var(--color-ink-2);
  }
</style>
