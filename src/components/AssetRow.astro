---
/* Index-First 의 행. 카드가 아니라 괘선으로 구분된 목록 행입니다.
 * 링크 자체가 버튼이므로 별도 CTA 를 두지 않습니다. */
import type { CollectionEntry } from 'astro:content';
import { KIND_LABEL, arcStep } from '../lib/labels';
import { payloadLineCount } from '../lib/payloads';

interface Props {
  entry: CollectionEntry<'assets'>;
}

const { entry } = Astro.props;
const { code, title, summary, kind } = entry.data;
const lines = payloadLineCount(entry.data.payload);
const step = arcStep(code);
---

<li class="row">
  <a href={`/assets/${entry.id}`}>
    <span class="code nums">{code}</span>
    <span class="main">
      <span class="title">{title}</span>
      <span class="summary">{summary}</span>
    </span>
    <span class="meta nums">
      {KIND_LABEL[kind]}{step && <span class="sep"> · </span>}{step}<span class="sep"> · </span>{lines}줄
    </span>
  </a>
</li>

<style>
  .row {
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  .row:first-child {
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  a {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-sm);
    padding-block: var(--space-sm);
    text-decoration: none;
  }
  a:hover .title {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
  }

  .main {
    display: block;
    min-width: 0;
  }
  .title {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .summary {
    display: block;
    margin-top: var(--space-3xs);
    color: var(--color-ink-2);
    font-size: var(--text-sm);
    max-width: 54ch;
  }

  /* 모노는 코드·식별자·콜로폰 세 자리에만 씁니다.
   * 네 번째 자리에 쓰기 시작하면 모노가 사실상 세 번째 본문 서체가 됩니다. */
  .meta {
    font-size: var(--text-xs);
    color: var(--color-ink-2);
    white-space: nowrap;
  }

  @media (max-width: 46rem) {
    a {
      grid-template-columns: 2.75rem minmax(0, 1fr);
      row-gap: var(--space-3xs);
    }
    .meta {
      grid-column: 2;
      white-space: normal;
    }
  }
</style>
