---
/**
 * 업무 arc — 자산 목록이 "잡동사니 N개"가 아니라 하나의 작업 체계로
 * 읽히게 하는 장치. code 순서가 곧 사업개발 업무 흐름입니다.
 * 아직 공개되지 않은(draft) 자산은 링크 없이 흐리게 표시합니다.
 */
import { getCollection } from 'astro:content';
import { ARC } from '../lib/labels';

/* arc 는 flow 묶음만 그립니다. ops·build 자산은 업무 흐름 위에 있지 않습니다. */
const published = await getCollection(
  'assets',
  ({ data }) => !data.draft && data.group === 'flow',
);
const idByCode = new Map(published.map((e) => [e.data.code, e.id]));
---

<ol class="arc" aria-label="사업개발 업무 흐름">
  {
    ARC.map(({ code, step }) => {
      const id = idByCode.get(code);
      return (
        <li class={id ? 'live' : 'pending'}>
          {id ? <a href={`/assets/${id}`}>{step}</a> : <span>{step}</span>}
        </li>
      );
    })
  }
</ol>

<style>
  .arc {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3xs);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-xs);
    color: var(--color-ink-2);
  }

  li + li::before {
    content: '→';
    margin-right: var(--space-3xs);
    color: var(--color-rule);
  }

  li a {
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }
  li a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .pending span {
    opacity: 0.45;
    white-space: nowrap;
  }
</style>
